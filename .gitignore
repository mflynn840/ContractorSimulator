# Unity generated files
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore

# ===============
# OS generated
# ===============
*.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?

# User specific
/*.user
/*.suo
/*.userprefs

# Visual Studio / MonoDevelop generated
/.vs/
/.vscode/
/.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb

# Unity3D generated
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
MemoryCaptures/
UserSettings/

# Unity Test Runner / Code Coverage
TestResults/
CodeCoverage/
**/TestResults.xml

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Uncomment this line if you wish to ignore the asset store tools plugin
# /Assets/AssetStoreTools*

# Autogenerated JetBrains Rider plugin
.idea/

# Packed Addressable files
/Assets/StreamingAssets/*

# Crashlytics
crashlytics-build.properties

# Uncomment to ignore all .meta files
# *.meta
